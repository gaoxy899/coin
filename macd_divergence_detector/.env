# Binance USD-M perpetual contracts, separated by commas.
SYMBOLS=BTCUSDT,SOLUSDT,ETHUSDT,HYPEUSDT

# Binance K-line intervals, separated by commas.
INTERVALS=1h,4h

# Check each interval this many whole minutes after its close.
# Example: 1h + 2 means 00:02, 01:02, 02:02 ...
CLOSE_DELAY_MINUTES=2

# Historical candles used to calculate MACD and identify the prior structure.
KLINE_LIMIT=1000

# Timestamps in console output.
DISPLAY_TIMEZONE=Asia/Taipei

# Run one current-bar-only check on process startup, then wait for schedules.
CHECK_ON_START=false

# Telegram notification (leave disabled until token is configured).
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001500906279
TELEGRAM_MENTION=@apm
