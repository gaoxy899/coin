# Binance API 密钥：实盘或 Testnet 自动交易必填；请只开启合约交易与读取账户权限，禁止提现。
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# 是否启用自动交易：false 只发送策略信号；true 才允许策略提交订单。
KALMAN_AUTO_TRADE=false

# 是否模拟执行：true (本地模拟)不读取私有账户余额、不提交订单；使用模拟账户交易:false。
KALMAN_DRY_RUN=true

# 是否使用 Binance Demo Trading（沿用旧变量名）；true 时需填写 Demo Trading 专用 API Key。
KALMAN_TESTNET=true

# K 线交易周期：默认 1h；支持 1m、3m、5m、15m、30m、1h、2h、4h、6h、8h、12h、1d、3d、1w。
KALMAN_TIMEFRAME=1h

# 逐仓初始杠杆：下单前会向交易所校验该值。
KALMAN_LEVERAGE=32

# 保证金模式：自动交易仅允许 isolated（逐仓），不允许 cross（全仓）。
KALMAN_MARGIN_MODE=isolated

# 单笔固定逐仓保证金，单位 USDT；每次开仓均使用该金额，不随账户余额变化。
KALMAN_MARGIN_USDT=3

# 单笔名义仓位硬上限，单位 USDT；防止余额较大时订单过大。
KALMAN_MAX_NOTIONAL_USDT=10000

# TP1 成交时减仓比例；0.5 表示止盈 50% 仓位。
KALMAN_TP1_FRACTION=0.5

# 仅模拟执行时使用的假设 USDT 账户权益；用于校验固定保证金是否充足并展示占比，实盘不会使用。
KALMAN_DRY_RUN_EQUITY_USDT=1000

# 旧参数兼容项：如设置，会作为名义仓位上限；请优先使用 KALMAN_MAX_NOTIONAL_USDT。
# KALMAN_ORDER_NOTIONAL_USDT=10000
