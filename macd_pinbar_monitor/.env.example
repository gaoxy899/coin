# Binance USD-M perpetual contracts and K-line intervals.
SYMBOLS=SOLUSDT,ETHUSDT
INTERVALS=1h,4h
CLOSE_DELAY_MINUTES=2
KLINE_LIMIT=1000
DISPLAY_TIMEZONE=Asia/Taipei
CHECK_ON_START=false

# separate: MACD and Pin Bar each notify independently.
# combined: only MACD + same-direction Pin Bar confirmation notifies.
# both: emit separate alerts and the combined confirmation alert.
ALERT_MODE=separate

# A matching Pin Bar may occur on the divergence confirmation candle or this
# many closed candles after it. Use 0 to require exactly the same candle.
PINBAR_MAX_BARS_AFTER_DIVERGENCE=2
STATE_FILE=.macd_pinbar_state.json

# Retry failed Binance requests before waiting for the next candle close.
API_RETRY_COUNT=3
API_RETRY_DELAY_SECONDS=2

# Optional Telegram notification. Never commit a real bot token.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MENTION=@apm
