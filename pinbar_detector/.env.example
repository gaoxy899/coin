# Telegram notification for real-time Pin Bar signals.
# Copy this file to .env and keep the Bot Token private.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001500906279
TELEGRAM_MENTION=@apm

# Sent-candle keys; prevents duplicate alerts when the same command runs again.
TELEGRAM_STATE_FILE=.pinbar_telegram_state.json
