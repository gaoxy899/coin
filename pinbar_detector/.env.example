# Pin Bar monitoring. Copy this file to .env and keep the Bot Token private.
# main.py checks each SYMBOLS × INTERVALS pair after the K-line closes.
SYMBOLS=BTCUSDT,ETHUSDT
INTERVALS=1h,4h
# Check one minute after each K-line close.
CLOSE_DELAY_MINUTES=1
KLINE_LIMIT=100
# Set true only when a restart should immediately inspect the newest closed bar.
CHECK_ON_START=false

# Retries for transient Binance/API failures.
API_RETRY_COUNT=3
API_RETRY_DELAY_SECONDS=2

# Optional Pin Bar thresholds. These values are the detector defaults.
PINBAR_MIN_RANGE_PCT=0.008
PINBAR_MIN_RANGE_ATR=1.0
PINBAR_MIN_MAIN_WICK_BODY_RATIO=3.0
PINBAR_MAX_OPPOSITE_WICK_BODY_RATIO=1.5
PINBAR_MIN_BODY_RANGE_RATIO=0.05
PINBAR_CLOSE_END_ZONE_RATIO=0.40
PINBAR_CONTEXT_LOOKBACK=12
PINBAR_ATR_PERIOD=14

# Telegram notification for real-time Pin Bar signals.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1001500906279
TELEGRAM_MENTION=@apm

# Sent-candle keys; prevents duplicate alerts when the same command runs again.
TELEGRAM_STATE_FILE=.pinbar_telegram_state.json

# Optional iPhone notification relay. It is independent of Telegram: set true
# to deliver the same new Pin Bar signal to this local endpoint as well.
IPHONE_ENABLED=false
IPHONE_NOTIFICATION_URL=http://127.0.0.1:8080/gaVimNrvTu6f6NDgsLvDcH
IPHONE_STATE_FILE=.pinbar_iphone_state.json
